rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function validEvidenceFile() {
      return request.resource != null &&
        request.resource.size > 0 &&
        request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp',
          'application/pdf'
        ];
    }

    // Regras para os avatares dos usuários
    match /avatars/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Regras para evidências do SSMA
    match /ssma/evidences/{competence}/{regionalId}/{costCenterId}/{inspectionEventId}/{fileName} {
      allow read: if isSignedIn();
      // Role/scope checks are enforced in Firestore/services because this project
      // does not currently issue SSMA custom claims to Firebase Auth tokens.
      allow create, update: if isSignedIn() && validEvidenceFile();
      allow delete: if false;
    }

    // Bloqueia acesso a qualquer outro arquivo não mapeado acima
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
