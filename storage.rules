rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function validEvidenceFile() {
      return request.resource != null &&
        request.resource.size > 0 &&
        request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp',
          'application/pdf'
        ];
    }

    // Regras para os avatares dos usuários
    match /avatars/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Regras para evidências do SSMA
    match /ssma/evidences/{competence}/{regionalId}/{costCenterId}/{inspectionEventId}/{fileName} {
      allow read: if isSignedIn();
      // Role/scope checks are enforced in Firestore/services because this project
      // does not currently issue SSMA custom claims to Firebase Auth tokens.
      allow create, update: if isSignedIn() && validEvidenceFile();
      allow delete: if false;
    }

    // Lakehouse financeiro: arquivos de carga (razão, budget, forecast...). Só quem tem a claim
    // finCarga (dada pela função finAutorizarCarga a super admins) envia; ninguém lê pelo navegador.
    // A claim evita consultar o Firestore daqui, o que exigiria permissão de IAM entre serviços.
    function canUploadFinance() {
      return isSignedIn() && request.auth.token.finCarga == true;
    }

    function validFinanceWorkbook() {
      return request.resource != null &&
        request.resource.size > 0 &&
        request.resource.size <= 100 * 1024 * 1024 &&
        request.resource.contentType in [
          'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
          'application/vnd.ms-excel',
          'application/vnd.ms-excel.sheet.macroEnabled.12'
        ];
    }

    match /fin-cargas/{tipo}/{cargaId}/{fileName} {
      allow read: if false;
      allow create: if canUploadFinance() && validFinanceWorkbook();
      allow update, delete: if false;
    }

    // Bloqueia acesso a qualquer outro arquivo não mapeado acima
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
