rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserProfile() {
      return get(/databases/$(database)/documents/user_profiles/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      let profile = getUserProfile();
      return profile != null && profile.isSuperAdmin == true;
    }

    function isIAMAdmin() {
      let profile = getUserProfile();
      return profile != null && (
        profile.isSuperAdmin == true ||
        (profile.modules != null && profile.modules.commercial != null && profile.modules.commercial.role == 'IAM_ADMIN')
      );
    }

    function hasHumanCapitalAccess() {
      let profile = getUserProfile();
      return profile != null && (
        profile.isSuperAdmin == true ||
        (
          profile.modules != null &&
          profile.modules.human_capital != null &&
          profile.modules.human_capital.enabled == true
        )
      );
    }

    function hcRole() {
      let profile = getUserProfile();
      return profile.isSuperAdmin == true ? 'CH_ADMIN' : profile.modules.human_capital.role;
    }

    function hcScope() {
      let profile = getUserProfile();
      return profile.isSuperAdmin == true ? { type: 'ALL' } : profile.modules.human_capital.scope;
    }

    function isCHAdmin() {
      // Temporary compatibility for user_profiles that still store HC_ADMIN.
      return hasHumanCapitalAccess() && hcRole() in ['CH_ADMIN', 'HC_ADMIN'];
    }

    function isCHPlanner() {
      // HC_* values are temporary read-time compatibility only; CH_* is the official standard.
      return hasHumanCapitalAccess() && hcRole() in [
        'CH_ADMIN',
        'CH_MANAGER',
        'CH_COSTCENTER_PLANNER',
        'CH_APPROVER',
        'HC_ADMIN',
        'HC_MANAGER',
        'HC_COSTCENTER_PLANNER',
        'HC_APPROVER'
      ];
    }

    function isCHAuditorReader() {
      return hasHumanCapitalAccess() && hcRole() in [
        'CH_ADMIN',
        'CH_MANAGER',
        'CH_COSTCENTER_PLANNER',
        'CH_APPROVER',
        'CH_AUDITOR_VIEWER',
        'HC_ADMIN',
        'HC_MANAGER',
        'HC_COSTCENTER_PLANNER',
        'HC_APPROVER',
        'HC_AUDITOR_VIEWER'
      ];
    }

    function canApproveCH() {
      return hasHumanCapitalAccess() && hcRole() in ['CH_ADMIN', 'CH_APPROVER', 'HC_ADMIN', 'HC_APPROVER'];
    }

    function isCHAllScope() {
      return hasHumanCapitalAccess() && hcScope().type == 'ALL';
    }

    function chCostCenterMatches(costCenter) {
      let scope = hcScope();
      return costCenter is string &&
        scope.type == 'COST_CENTER' &&
        costCenter in scope.costCenters;
    }

    function chRegionalMatches(data) {
      let scope = hcScope();
      return scope.type == 'REGIONAL' && (
        (data.keys().hasAny(['regional']) && data.regional in scope.regionals) ||
        (data.keys().hasAny(['regionalId']) && data.regionalId in scope.regionals)
      );
    }

    function isCHScopedData(data) {
      let scope = hcScope();
      return scope.type == 'ALL' ||
        chRegionalMatches(data) ||
        (data.keys().hasAny(['costCenter']) && chCostCenterMatches(data.costCenter)) ||
        (data.keys().hasAny(['centroCusto']) && chCostCenterMatches(data.centroCusto));
    }

    function canManageCHReferenceData() {
      return isCHAdmin() && isCHAllScope();
    }

    function optionalPlanningStatus(data) {
      return !data.keys().hasAny(['status']) || data.status in ['draft', 'pending', 'approved', 'rejected'];
    }

    // ── Fluxo do planejamento de horas extras ────────────────────────────────
    // draft    = salvo pelo engenheiro, aguardando o gerente regional
    // pending  = enviado pelo gerente, aguardando o diretor
    // approved = aprovado pelo diretor
    // rejected = devolvido pelo diretor ao engenheiro (com motivo)
    function isCHManager() {
      return hasHumanCapitalAccess() && hcRole() in ['CH_MANAGER', 'HC_MANAGER'];
    }

    function planningStatus(data) {
      return data.keys().hasAny(['status']) ? data.status : 'draft';
    }

    function planningHoursUnchanged() {
      return request.resource.data.plannedHours == resource.data.plannedHours;
    }

    // Quem pode levar um registro do status `fromStatus` para `toStatus`.
    function canTransitionPlanning(fromStatus, toStatus) {
      return canApproveCH() ||
        // Gerente: edita o que ainda não foi enviado e envia ao diretor.
        (isCHManager() && fromStatus in ['draft', 'rejected'] && toStatus in ['draft', 'pending']) ||
        // Engenheiro (e demais planejadores): só salva o que ainda não foi enviado.
        (fromStatus in ['draft', 'rejected'] && toStatus == 'draft');
    }

    function validCHPlanning(data) {
      return data.keys().hasAll(['chapa', 'nome', 'costCenter', 'date', 'type', 'plannedHours']) &&
        data.chapa is string &&
        data.nome is string &&
        data.costCenter is string &&
        data.type in ['DAILY', 'MONTHLY'] &&
        (
          (data.type == 'DAILY' && validDate(data.date)) ||
          (data.type == 'MONTHLY' && validCompetence(data.date))
        ) &&
        data.plannedHours is number &&
        data.plannedHours >= 0 &&
        optionalPlanningStatus(data);
    }

    function validCHBudget(data) {
      return data.keys().hasAll(['monthKey', 'month', 'costCenter', 'value']) &&
        validCompetence(data.monthKey) &&
        data.month is string &&
        data.costCenter is string &&
        data.value is number;
    }

    function validCHSalaryAllocation(data) {
      return data.keys().hasAll(['monthKey', 'chapa', 'status', 'costCenter', 'allocation', 'salary']) &&
        validCompetence(data.monthKey) &&
        data.chapa is string &&
        data.status is string &&
        data.costCenter is string &&
        data.allocation is number &&
        data.allocation >= 0 &&
        data.allocation <= 1 &&
        data.salary is number &&
        data.salary >= 0;
    }

    function validCHManualEmployee(data) {
      return data.keys().hasAll(['id', 'chapa', 'name', 'costCenter', 'role', 'status']) &&
        data.id is string &&
        data.chapa is string &&
        data.name is string &&
        data.costCenter is string &&
        data.role is string &&
        data.status in ['ACTIVE', 'INACTIVE'];
    }

    function validCHGlobalEmployee(data) {
      return data.keys().hasAll(['chapa', 'nome', 'funcao', 'costCenter']) &&
        data.chapa is string &&
        data.nome is string &&
        data.funcao is string &&
        data.costCenter is string;
    }

    function validCHHeadcount(data) {
      return data.keys().hasAll(['dataInicio', 'dataFim', 'chapa', 'centroCusto', 'distribuicao']) &&
        validDate(data.dataInicio) &&
        validDate(data.dataFim) &&
        data.dataInicio <= data.dataFim &&
        data.chapa is string &&
        data.centroCusto is string &&
        data.distribuicao is number &&
        data.distribuicao > 0 &&
        data.distribuicao <= 1 &&
        (!data.keys().hasAny(['salario']) || data.salario is number);
    }

    function validCHTeam(data) {
      return data.keys().hasAll(['id', 'name', 'costCenter']) &&
        data.id is string &&
        data.name is string &&
        data.costCenter is string;
    }

    function validCHTeamAllocation(data) {
      return data.keys().hasAll(['id', 'teamId', 'monthKey', 'chapas']) &&
        data.id is string &&
        data.teamId is string &&
        validCompetence(data.monthKey) &&
        data.chapas is list;
    }

    function validCHAuditLog(data) {
      return data.keys().hasAll(['action', 'userEmail']) &&
        data.action is string &&
        data.userEmail is string;
    }

    function ssmaModule() {
      return getUserProfile().modules.ssma;
    }

    function ssmaRole() {
      return isSuperAdmin() ? 'SSMA_MANAGER' : ssmaModule().role;
    }

    function ssmaScope() {
      return isSuperAdmin() ? { type: 'ALL' } : ssmaModule().scope;
    }

    function hasSSMAAccess() {
      let profile = getUserProfile();
      return profile != null && (
        profile.isSuperAdmin == true ||
        (profile.modules.ssma != null && profile.modules.ssma.enabled == true)
      );
    }

    function isSSMAManager() {
      return hasSSMAAccess() && ssmaRole() in ['SSMA_ADMIN', 'SSMA_MANAGER'];
    }

    function isSSMAViewer() {
      return hasSSMAAccess() && ssmaRole() == 'SSMA_VIEWER';
    }

    function isSSMAOperational() {
      return hasSSMAAccess() && ssmaRole() in [
        'SSMA_ADMIN',
        'SSMA_MANAGER',
        'SSMA_REGIONAL_MANAGER',
        'SSMA_SITE_MANAGER',
        'SSMA_SUPERVISOR',
        'SSMA_TECHNICIAN',
        'SSMA_FOREMAN'
      ];
    }

    function canManageSSMARegisters() {
      return isSSMAManager();
    }

    function isInSSMAScope(regionalId, costCenterId) {
      return isSSMAManager() ||
        ssmaScope().type == 'ALL' ||
        (ssmaScope().type == 'REGIONAL' && regionalId in ssmaScope().regionals) ||
        (ssmaScope().type == 'COST_CENTER' && costCenterId in ssmaScope().costCenters);
    }

    function immutableCreateAuditFields() {
      return request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdAt is string;
    }

    function preservesCreateAuditFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'id',
        'createdAt',
        'createdBy',
        'createdByNameSnapshot'
      ]);
    }

    function validCompetence(value) {
      return value is string && value.matches('^\\d{4}-(0[1-9]|1[0-2])$');
    }

    function validDate(value) {
      return value is string && value.matches('^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$');
    }

    function validInspectionEvent(data) {
      return validCompetence(data.competence) &&
        validDate(data.date) &&
        data.inspectionType in ['IFS', 'ALOJAMENTO'] &&
        data.status in ['VALID', 'CANCELLED'] &&
        data.regionalId is string && data.regionalId.size() > 0 &&
        data.costCenterId is string && data.costCenterId.size() > 0 &&
        data.executorUid is string && data.executorUid.size() > 0 &&
        data.executorFunctionGroup in ['GREG', 'GESTOR', 'SUPSSMA', 'TST', 'ENCARREGADO'];
    }

    function validEventCancellationTransition() {
      return request.resource.data.status != 'CANCELLED' ||
        (
          request.resource.data.cancelledBy == request.auth.uid &&
          request.resource.data.cancelledAt is string &&
          request.resource.data.cancelReason is string &&
          request.resource.data.cancelReason.size() > 0
        );
    }

    function validMonthlyTarget(data) {
      return validCompetence(data.competence) &&
        data.employeeUid is string && data.employeeUid.size() > 0 &&
        data.functionGroup in ['GREG', 'GESTOR', 'SUPSSMA', 'TST', 'ENCARREGADO'] &&
        data.metaIFS is number && data.metaIFS >= 0 &&
        data.metaAlojamento is number && data.metaAlojamento >= 0;
    }

    function validEvidence(data) {
      return validCompetence(data.competence) &&
        data.inspectionEventId is string && data.inspectionEventId.size() > 0 &&
        data.regionalId is string && data.regionalId.size() > 0 &&
        data.costCenterId is string && data.costCenterId.size() > 0 &&
        data.mimeType in ['image/jpeg', 'image/png', 'image/webp', 'application/pdf'] &&
        data.sizeBytes is number && data.sizeBytes > 0 && data.sizeBytes <= 10 * 1024 * 1024 &&
        data.active is bool;
    }

    match /user_profiles/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isIAMAdmin());
      allow write: if isAuthenticated() && isIAMAdmin();
    }

    match /user_directory/{userId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /audit_logs/{logId} {
      allow read, write: if isAuthenticated() && isIAMAdmin();
    }

    match /users/{userId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isIAMAdmin());
    }

    match /hc_planning_records/{recordId} {
      allow read: if isAuthenticated() && isCHAuditorReader() && isCHScopedData(resource.data);
      allow create: if isAuthenticated() && isCHPlanner() &&
        validCHPlanning(request.resource.data) &&
        isCHScopedData(request.resource.data) &&
        canTransitionPlanning('draft', planningStatus(request.resource.data));
      allow update: if isAuthenticated() && isCHPlanner() &&
        validCHPlanning(request.resource.data) &&
        isCHScopedData(resource.data) &&
        isCHScopedData(request.resource.data) &&
        (
          // Diretor/admin: qualquer alteração.
          canApproveCH() ||
          // Demais: transição permitida ao perfil; o envio ao diretor não altera horas.
          (
            canTransitionPlanning(planningStatus(resource.data), planningStatus(request.resource.data)) &&
            (planningStatus(request.resource.data) != 'pending' || planningHoursUnchanged())
          )
        );
      allow delete: if isAuthenticated() && canManageCHReferenceData();
    }

    match /hc_budgets/{budgetId} {
      allow read: if isAuthenticated() && isCHAuditorReader() && isCHScopedData(resource.data);
      allow create: if isAuthenticated() && canManageCHReferenceData() && validCHBudget(request.resource.data);
      allow update: if isAuthenticated() && canManageCHReferenceData() && validCHBudget(request.resource.data);
      allow delete: if isAuthenticated() && canManageCHReferenceData();
    }

    match /hc_salary_allocations/{salaryId} {
      allow read: if isAuthenticated() && isCHAuditorReader() && isCHScopedData(resource.data);
      allow create: if isAuthenticated() && canManageCHReferenceData() && validCHSalaryAllocation(request.resource.data);
      allow update: if isAuthenticated() && canManageCHReferenceData() && validCHSalaryAllocation(request.resource.data);
      allow delete: if isAuthenticated() && canManageCHReferenceData();
    }

    match /hc_headcount/{headcountId} {
      allow read: if isAuthenticated() && isCHAuditorReader() && isCHScopedData(resource.data);
      allow create: if isAuthenticated() && canManageCHReferenceData() && validCHHeadcount(request.resource.data);
      allow update: if isAuthenticated() && canManageCHReferenceData() && validCHHeadcount(request.resource.data);
      allow delete: if isAuthenticated() && canManageCHReferenceData();
    }

    match /hc_manual_employees/{employeeId} {
      allow read: if isAuthenticated() && isCHAuditorReader() && isCHScopedData(resource.data);
      allow create: if isAuthenticated() && isCHPlanner() && validCHManualEmployee(request.resource.data) && isCHScopedData(request.resource.data);
      allow update: if isAuthenticated() && isCHPlanner() &&
        validCHManualEmployee(request.resource.data) &&
        isCHScopedData(resource.data) &&
        isCHScopedData(request.resource.data);
      allow delete: if isAuthenticated() && canManageCHReferenceData();
    }

    match /hc_global_employees/{employeeId} {
      allow read: if isAuthenticated() && isCHAuditorReader() && isCHScopedData(resource.data);
      allow create: if isAuthenticated() && isCHPlanner() && validCHGlobalEmployee(request.resource.data) && isCHScopedData(request.resource.data);
      allow update: if isAuthenticated() && isCHPlanner() &&
        validCHGlobalEmployee(request.resource.data) &&
        isCHScopedData(resource.data) &&
        isCHScopedData(request.resource.data);
      allow delete: if isAuthenticated() && canManageCHReferenceData();
    }

    match /hc_teams/{teamId} {
      allow read: if isAuthenticated() && isCHAuditorReader() && isCHScopedData(resource.data);
      allow create: if isAuthenticated() && canManageCHReferenceData() && validCHTeam(request.resource.data);
      allow update: if isAuthenticated() && canManageCHReferenceData() && validCHTeam(request.resource.data);
      allow delete: if isAuthenticated() && canManageCHReferenceData();
    }

    match /hc_team_allocations/{allocationId} {
      // Limitation: these legacy docs do not denormalize costCenter/regional.
      // Until that schema changes, access is restricted to CH admins with ALL scope.
      allow read: if isAuthenticated() && canManageCHReferenceData();
      allow create: if isAuthenticated() && canManageCHReferenceData() && validCHTeamAllocation(request.resource.data);
      allow update: if isAuthenticated() && canManageCHReferenceData() && validCHTeamAllocation(request.resource.data);
      allow delete: if isAuthenticated() && canManageCHReferenceData();
    }

    match /hc_audit_logs/{logId} {
      allow read: if isAuthenticated() && hasHumanCapitalAccess() && (isCHAdmin() || canApproveCH() || hcRole() in ['CH_AUDITOR_VIEWER', 'HC_AUDITOR_VIEWER']);
      allow create: if isAuthenticated() && hasHumanCapitalAccess() && validCHAuditLog(request.resource.data);
      allow update, delete: if false;
    }

    match /ssma_regionals/{id} {
      // Regional names are treated as catalog data; event/evidence access remains scoped.
      allow read: if isAuthenticated() && hasSSMAAccess();
      allow create: if isAuthenticated() && canManageSSMARegisters() && immutableCreateAuditFields();
      allow update: if isAuthenticated() && canManageSSMARegisters() && preservesCreateAuditFields();
      allow delete: if false;
    }

    match /ssma_cost_centers/{id} {
      allow read: if isAuthenticated() && hasSSMAAccess() && isInSSMAScope(resource.data.regionalId, resource.data.id);
      allow create: if isAuthenticated() && canManageSSMARegisters() && immutableCreateAuditFields();
      allow update: if isAuthenticated() && canManageSSMARegisters() && preservesCreateAuditFields();
      allow delete: if false;
    }

    match /ssma_employees/{id} {
      allow read: if isAuthenticated() && hasSSMAAccess();
      allow create: if isAuthenticated() && canManageSSMARegisters() && immutableCreateAuditFields();
      allow update: if isAuthenticated() && canManageSSMARegisters() && preservesCreateAuditFields();
      allow delete: if false;
    }

    match /ssma_rules/{id} {
      allow read: if isAuthenticated() && hasSSMAAccess();
      allow create: if isAuthenticated() && isSSMAManager() && immutableCreateAuditFields();
      allow update: if isAuthenticated() && isSSMAManager() && preservesCreateAuditFields();
      allow delete: if false;
    }

    match /ssma_inspections/{id} {
      allow read: if isAuthenticated() && hasSSMAAccess();
      allow create, update: if isAuthenticated() && isSSMAOperational();
      allow delete: if false;
    }

    match /ssma_monthly_targets/{id} {
      // Limitation: target docs are person-scoped and do not denormalize regional/costCenter scope.
      // Reads are module-wide for SSMA users; UI/services filter visible people by IAM scope.
      allow read: if isAuthenticated() && hasSSMAAccess();
      allow create: if isAuthenticated() && isSSMAManager() && validMonthlyTarget(request.resource.data) && immutableCreateAuditFields();
      allow update: if isAuthenticated() && isSSMAManager() && validMonthlyTarget(request.resource.data) && preservesCreateAuditFields();
      allow delete: if false;
    }

    match /ssma_inspection_events/{id} {
      allow read: if isAuthenticated() && hasSSMAAccess() && isInSSMAScope(resource.data.regionalId, resource.data.costCenterId);
      allow create: if isAuthenticated() && isSSMAOperational() &&
        validInspectionEvent(request.resource.data) &&
        isInSSMAScope(request.resource.data.regionalId, request.resource.data.costCenterId) &&
        request.resource.data.status == 'VALID' &&
        immutableCreateAuditFields();
      allow update: if isAuthenticated() && isSSMAOperational() &&
        isInSSMAScope(resource.data.regionalId, resource.data.costCenterId) &&
        isInSSMAScope(request.resource.data.regionalId, request.resource.data.costCenterId) &&
        validInspectionEvent(request.resource.data) &&
        preservesCreateAuditFields() &&
        validEventCancellationTransition();
      allow delete: if false;
    }

    match /ssma_evidences/{id} {
      allow read: if isAuthenticated() && hasSSMAAccess() && isInSSMAScope(resource.data.regionalId, resource.data.costCenterId);
      allow create: if isAuthenticated() && isSSMAOperational() &&
        validEvidence(request.resource.data) &&
        isInSSMAScope(request.resource.data.regionalId, request.resource.data.costCenterId) &&
        request.resource.data.uploadedBy == request.auth.uid;
      allow update: if isAuthenticated() && isSSMAOperational() &&
        validEvidence(request.resource.data) &&
        isInSSMAScope(resource.data.regionalId, resource.data.costCenterId) &&
        isInSSMAScope(request.resource.data.regionalId, request.resource.data.costCenterId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'id',
          'inspectionEventId',
          'competence',
          'regionalId',
          'costCenterId',
          'storagePath',
          'downloadUrl',
          'fileName',
          'mimeType',
          'sizeBytes',
          'uploadedAt',
          'uploadedBy',
          'uploadedByNameSnapshot'
        ]);
      allow delete: if false;
    }

    match /ssma_monthly_person_results/{id} {
      allow read: if isAuthenticated() && hasSSMAAccess();
      allow create, update: if isAuthenticated() && isSSMAManager();
      allow delete: if false;
    }

    match /ssma_monthly_collective_results/{id} {
      allow read: if isAuthenticated() && hasSSMAAccess();
      allow create, update: if isAuthenticated() && isSSMAManager();
      allow delete: if false;
    }

    match /ssma_monthly_results/{id} {
      allow read: if isAuthenticated() && hasSSMAAccess();
      allow create, update: if isAuthenticated() && isSSMAManager();
      allow delete: if false;
    }

    match /ssma_audit_logs/{id} {
      allow read: if isAuthenticated() && isSSMAManager();
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
